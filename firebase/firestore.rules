rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read, update: if isOwner(userId);
      allow delete: if false;
    }

    match /salons/{salonId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /professionals/{professionalId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /clients/{clientId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read, update: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.professionalId == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        resource.data.salonOwnerId == request.auth.uid
      );
      allow delete: if false;
    }

    match /opportunities/{opportunityId} {
      allow create: if signedIn() && request.resource.data.salonOwnerId == request.auth.uid;
      allow read: if signedIn();
      allow update: if signedIn() && (
        resource.data.salonOwnerId == request.auth.uid ||
        resource.data.professionalId == request.auth.uid
      );
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
