rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function sameUser(uid) { return signedIn() && request.auth.uid == uid; }
    function userRole(role) {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    function salonOwner(data) {
      return signedIn() && data.salonOwnerId == request.auth.uid;
    }
    function professionalOwner(data) {
      return signedIn() && data.professionalOwnerId == request.auth.uid;
    }
    function clientOwner(data) {
      return signedIn() && data.clientOwnerId == request.auth.uid;
    }

    match /users/{uid} {
      allow create: if sameUser(uid);
      allow read, update, delete: if sameUser(uid);
    }

    match /salons/{salonId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /professionals/{professionalId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /clients/{clientId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /opportunities/{opportunityId} {
      allow create: if userRole('salao') && salonOwner(request.resource.data);
      allow get, list: if salonOwner(resource.data) || resource.data.status == 'aberta' || professionalOwner(resource.data);
      allow update: if (
        salonOwner(resource.data) && salonOwner(request.resource.data)
      ) || (
        userRole('profissional') && resource.data.status == 'aberta' &&
        request.resource.data.salonOwnerId == resource.data.salonOwnerId &&
        request.resource.data.professionalOwnerId == request.auth.uid
      );
      allow delete: if salonOwner(resource.data);
    }

    match /appointments/{appointmentId} {
      allow create: if (
        salonOwner(request.resource.data) ||
        professionalOwner(request.resource.data) ||
        clientOwner(request.resource.data)
      );
      allow get, list: if (
        salonOwner(resource.data) ||
        professionalOwner(resource.data) ||
        clientOwner(resource.data)
      );
      allow update: if (
        salonOwner(resource.data) && salonOwner(request.resource.data)
      ) || (
        professionalOwner(resource.data) && professionalOwner(request.resource.data)
      ) || (
        clientOwner(resource.data) && clientOwner(request.resource.data)
      );
      allow delete: if salonOwner(resource.data) || clientOwner(resource.data);
    }

    match /transactions/{transactionId} {
      allow create: if salonOwner(request.resource.data) || professionalOwner(request.resource.data);
      allow get, list: if salonOwner(resource.data) || professionalOwner(resource.data);
      allow update: if (
        salonOwner(resource.data) && salonOwner(request.resource.data)
      ) || (
        professionalOwner(resource.data) && professionalOwner(request.resource.data)
      );
      allow delete: if false;
    }
  }
}
